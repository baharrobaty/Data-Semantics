<?xml version="1.0"?>


<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY swrl "http://www.w3.org/2003/11/swrl#" >
    <!ENTITY swrlb "http://www.w3.org/2003/11/swrlb#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
    <!ENTITY swrla "http://swrl.stanford.edu/ontologies/3.3/swrla.owl#" >
    <!ENTITY companies-geo "http://www.inside.disco.unimib.it/ds/test/companies-geo/" >
    <!ENTITY companies-geo2 "http://www.inside.disco.unimib.it/ds/test/companies-geo#" >
    <!ENTITY untitled-ontology-15 "http://www.siti.disco.unimib.it/cmm/2013/untitled-ontology-15#" >
]>


<rdf:RDF xmlns="http://www.inside.disco.unimib.it/ds/test/geo-clean-domain-range#"
     xml:base="http://www.inside.disco.unimib.it/ds/test/geo-clean-domain-range"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:companies-geo2="http://www.inside.disco.unimib.it/ds/test/companies-geo#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:companies-geo="http://www.inside.disco.unimib.it/ds/test/companies-geo/"
     xmlns:untitled-ontology-15="http://www.siti.disco.unimib.it/cmm/2013/untitled-ontology-15#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#">
    <owl:Ontology rdf:about="http://www.inside.disco.unimib.it/ds/test/companies-geo"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="&swrla;isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#attendsUniversity -->

    <owl:ObjectProperty rdf:about="&companies-geo2;attendsUniversity">
        <rdfs:domain rdf:resource="&companies-geo2;Student"/>
        <rdfs:range rdf:resource="&companies-geo2;University"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#friendOf -->

    <owl:ObjectProperty rdf:about="&companies-geo2;friendOf">
        <rdfs:range rdf:resource="&companies-geo2;Person"/>
        <rdfs:domain rdf:resource="&companies-geo2;Person"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#hasBirthplace -->

    <owl:ObjectProperty rdf:about="&companies-geo2;hasBirthplace">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="&companies-geo2;Person"/>
        <rdfs:range rdf:resource="&companies-geo;City"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#hasStudent -->

    <owl:ObjectProperty rdf:about="&companies-geo2;hasStudent">
        <rdfs:range rdf:resource="&companies-geo2;Student"/>
        <rdfs:domain rdf:resource="&companies-geo2;University"/>
        <owl:inverseOf rdf:resource="&companies-geo2;attendsUniversity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/administrativePartOf -->

    <owl:ObjectProperty rdf:about="&companies-geo;administrativePartOf">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:range rdf:resource="&companies-geo;GeoEntity"/>
        <rdfs:domain rdf:resource="&companies-geo;GeoEntity"/>
        <rdfs:subPropertyOf rdf:resource="&companies-geo;transitiveAdminPartOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/administrativelyContains -->

    <owl:ObjectProperty rdf:about="&companies-geo;administrativelyContains">
        <owl:inverseOf rdf:resource="&companies-geo;transitiveAdminPartOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/capitalOf -->

    <owl:ObjectProperty rdf:about="&companies-geo;capitalOf">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="&companies-geo;City"/>
        <rdfs:range rdf:resource="&companies-geo;Country"/>
        <rdfs:subPropertyOf rdf:resource="&companies-geo;partOfCountry"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/hasHeadquartersIn -->

    <owl:ObjectProperty rdf:about="&companies-geo;hasHeadquartersIn">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:range rdf:resource="&companies-geo;GeoEntity"/>
        <rdfs:subPropertyOf rdf:resource="&companies-geo;hasOfficesIn"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/hasOfficesIn -->

    <owl:ObjectProperty rdf:about="&companies-geo;hasOfficesIn">
        <rdfs:range rdf:resource="&companies-geo;GeoEntity"/>
        <rdfs:domain rdf:resource="&companies-geo;Organization"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/partOfContinent -->

    <owl:ObjectProperty rdf:about="&companies-geo;partOfContinent">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:range rdf:resource="&companies-geo;Continent"/>
        <rdfs:domain rdf:resource="&companies-geo;Country"/>
        <rdfs:subPropertyOf rdf:resource="&companies-geo;administrativePartOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/partOfCountry -->

    <owl:ObjectProperty rdf:about="&companies-geo;partOfCountry">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="&companies-geo;City"/>
        <rdfs:range rdf:resource="&companies-geo;Country"/>
        <rdfs:subPropertyOf rdf:resource="&owl;topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/partOfRegion -->

    <owl:ObjectProperty rdf:about="&companies-geo;partOfRegion">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="&companies-geo;City"/>
        <rdfs:range rdf:resource="&companies-geo;Region"/>
        <rdfs:subPropertyOf rdf:resource="&companies-geo;administrativePartOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/regionPartOfCountry -->

    <owl:ObjectProperty rdf:about="&companies-geo;regionPartOfCountry">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:range rdf:resource="&companies-geo;Country"/>
        <rdfs:domain rdf:resource="&companies-geo;Region"/>
        <rdfs:subPropertyOf rdf:resource="&companies-geo;administrativePartOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/transitiveAdminPartOf -->

    <owl:ObjectProperty rdf:about="&companies-geo;transitiveAdminPartOf">
        <rdf:type rdf:resource="&owl;TransitiveProperty"/>
        <rdfs:domain rdf:resource="&companies-geo;GeoEntity"/>
        <rdfs:range rdf:resource="&companies-geo;GeoEntity"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#hasAddress -->

    <owl:DatatypeProperty rdf:about="&companies-geo2;hasAddress">
        <rdfs:domain rdf:resource="&companies-geo2;University"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#hasName -->

    <owl:DatatypeProperty rdf:about="&companies-geo2;hasName">
        <rdfs:domain rdf:resource="&companies-geo2;Person"/>
        <rdfs:range rdf:resource="&xsd;string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/area -->

    <owl:DatatypeProperty rdf:about="&companies-geo;area"/>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/density -->

    <owl:DatatypeProperty rdf:about="&companies-geo;density"/>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/population -->

    <owl:DatatypeProperty rdf:about="&companies-geo;population">
        <rdfs:domain rdf:resource="&companies-geo;GeoEntity"/>
        <rdfs:range rdf:resource="&xsd;integer"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#Person -->

    <owl:Class rdf:about="&companies-geo2;Person"/>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#Student -->

    <owl:Class rdf:about="&companies-geo2;Student">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="&companies-geo2;Person"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="&companies-geo2;attendsUniversity"/>
                        <owl:someValuesFrom rdf:resource="&companies-geo2;University"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="&companies-geo2;Person"/>
        <owl:disjointWith rdf:resource="&companies-geo2;University"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#University -->

    <owl:Class rdf:about="&companies-geo2;University">
        <rdfs:subClassOf rdf:resource="&companies-geo;Organization"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/AfricanCountry -->

    <owl:Class rdf:about="&companies-geo;AfricanCountry">
        <rdfs:subClassOf rdf:resource="&companies-geo;Country"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/AmericanCountry -->

    <owl:Class rdf:about="&companies-geo;AmericanCountry">
        <rdfs:subClassOf rdf:resource="&companies-geo;Country"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/AsianCountry -->

    <owl:Class rdf:about="&companies-geo;AsianCountry">
        <rdfs:subClassOf rdf:resource="&companies-geo;Country"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/City -->

    <owl:Class rdf:about="&companies-geo;City">
        <rdfs:subClassOf rdf:resource="&companies-geo;GeoEntity"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Company -->

    <owl:Class rdf:about="&companies-geo;Company">
        <rdfs:subClassOf rdf:resource="&companies-geo;Organization"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Continent -->

    <owl:Class rdf:about="&companies-geo;Continent">
        <rdfs:subClassOf rdf:resource="&companies-geo;GeoEntity"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Country -->

    <owl:Class rdf:about="&companies-geo;Country">
        <rdfs:subClassOf rdf:resource="&companies-geo;GeoEntity"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/EuropeanCountry -->

    <owl:Class rdf:about="&companies-geo;EuropeanCountry">
        <rdfs:subClassOf rdf:resource="&companies-geo;Country"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/GeoEntity -->

    <owl:Class rdf:about="&companies-geo;GeoEntity">
        <owl:disjointWith rdf:resource="&companies-geo;Organization"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/NGO -->

    <owl:Class rdf:about="&companies-geo;NGO">
        <rdfs:label xml:lang="en">Non-profit Organization</rdfs:label>
        <rdfs:subClassOf rdf:resource="&companies-geo;Organization"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/OceanianCountry -->

    <owl:Class rdf:about="&companies-geo;OceanianCountry">
        <rdfs:subClassOf rdf:resource="&companies-geo;Country"/>
    </owl:Class>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Organization -->

    <owl:Class rdf:about="&companies-geo;Organization"/>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Region -->

    <owl:Class rdf:about="&companies-geo;Region">
        <rdfs:subClassOf rdf:resource="&companies-geo;GeoEntity"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#Bahareh -->

    <owl:NamedIndividual rdf:about="&companies-geo2;Bahareh">
        <rdf:type rdf:resource="&companies-geo2;Student"/>
        <companies-geo2:hasName>Bahareh Robaty</companies-geo2:hasName>
        <companies-geo2:attendsUniversity rdf:resource="&companies-geo2;Bicocca_University"/>
        <companies-geo2:friendOf rdf:resource="&companies-geo2;Sophia"/>
        <companies-geo2:hasBirthplace rdf:resource="&companies-geo;Milan"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#Bicocca_University -->

    <owl:NamedIndividual rdf:about="&companies-geo2;Bicocca_University">
        <rdf:type rdf:resource="&companies-geo2;University"/>
        <companies-geo2:hasAddress>Milano, Bicocca</companies-geo2:hasAddress>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#Milano_University -->

    <owl:NamedIndividual rdf:about="&companies-geo2;Milano_University">
        <rdf:type rdf:resource="&companies-geo2;University"/>
        <companies-geo2:hasAddress>Milano. Italy</companies-geo2:hasAddress>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo#Sophia -->

    <owl:NamedIndividual rdf:about="&companies-geo2;Sophia">
        <rdf:type rdf:resource="&companies-geo2;Student"/>
        <companies-geo2:hasName>Sophia Jackson</companies-geo2:hasName>
        <companies-geo2:attendsUniversity rdf:resource="&companies-geo2;Milano_University"/>
        <companies-geo2:hasBirthplace rdf:resource="&companies-geo;Rome"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Africa -->

    <owl:NamedIndividual rdf:about="&companies-geo;Africa">
        <rdf:type rdf:resource="&companies-geo;Continent"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/America -->

    <owl:NamedIndividual rdf:about="&companies-geo;America">
        <rdf:type rdf:resource="&companies-geo;Continent"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Asia -->

    <owl:NamedIndividual rdf:about="&companies-geo;Asia">
        <rdf:type rdf:resource="&companies-geo;Continent"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Berlin -->

    <owl:NamedIndividual rdf:about="&companies-geo;Berlin">
        <rdf:type rdf:resource="&companies-geo;City"/>
        <companies-geo:capitalOf rdf:resource="&companies-geo;Germany"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Bonn -->

    <owl:NamedIndividual rdf:about="&companies-geo;Bonn">
        <rdf:type rdf:resource="&companies-geo;City"/>
        <companies-geo:partOfCountry rdf:resource="&companies-geo;Germany"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Emergency -->

    <owl:NamedIndividual rdf:about="&companies-geo;Emergency">
        <rdf:type rdf:resource="&companies-geo;NGO"/>
        <companies-geo:hasHeadquartersIn rdf:resource="&companies-geo;Italy"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Europe -->

    <owl:NamedIndividual rdf:about="&companies-geo;Europe">
        <rdf:type rdf:resource="&companies-geo;GeoEntity"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/FCA -->

    <owl:NamedIndividual rdf:about="&companies-geo;FCA">
        <rdf:type rdf:resource="&companies-geo;Company"/>
        <companies-geo:hasHeadquartersIn rdf:resource="&companies-geo;Netherlands"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/France -->

    <owl:NamedIndividual rdf:about="&companies-geo;France">
        <rdf:type rdf:resource="&companies-geo;Country"/>
        <companies-geo:population rdf:datatype="&xsd;integer">67000000</companies-geo:population>
        <companies-geo:partOfContinent rdf:resource="&companies-geo;Europe"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Germany -->

    <owl:NamedIndividual rdf:about="&companies-geo;Germany">
        <rdf:type rdf:resource="&companies-geo;Country"/>
        <companies-geo:population rdf:datatype="&xsd;integer">82790000</companies-geo:population>
        <companies-geo:partOfContinent rdf:resource="&companies-geo;Europe"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Italy -->

    <owl:NamedIndividual rdf:about="&companies-geo;Italy">
        <rdf:type rdf:resource="&companies-geo;GeoEntity"/>
        <companies-geo:population rdf:datatype="&xsd;integer">60480000</companies-geo:population>
        <companies-geo:partOfContinent rdf:resource="&companies-geo;Europe"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Lazio -->

    <owl:NamedIndividual rdf:about="&companies-geo;Lazio">
        <rdf:type rdf:resource="&companies-geo;Region"/>
        <companies-geo:regionPartOfCountry rdf:resource="&companies-geo;Italy"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Lombardy -->

    <owl:NamedIndividual rdf:about="&companies-geo;Lombardy">
        <rdf:type rdf:resource="&companies-geo;Region"/>
        <companies-geo:population rdf:datatype="&xsd;integer">10000000</companies-geo:population>
        <companies-geo:area rdf:datatype="&xsd;integer">23800</companies-geo:area>
        <companies-geo:regionPartOfCountry rdf:resource="&companies-geo;Italy"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/MSF -->

    <owl:NamedIndividual rdf:about="&companies-geo;MSF">
        <rdf:type rdf:resource="&companies-geo;NGO"/>
        <companies-geo:hasHeadquartersIn rdf:resource="&companies-geo;Paris"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Milan -->

    <owl:NamedIndividual rdf:about="&companies-geo;Milan">
        <companies-geo:partOfCountry rdf:resource="&companies-geo;Italy"/>
        <companies-geo:partOfRegion rdf:resource="&companies-geo;Lombardy"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Netherlands -->

    <owl:NamedIndividual rdf:about="&companies-geo;Netherlands">
        <rdf:type rdf:resource="&companies-geo;Country"/>
        <companies-geo:population rdf:datatype="&xsd;integer">17180000</companies-geo:population>
        <companies-geo:partOfContinent rdf:resource="&companies-geo;Europe"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Oceania -->

    <owl:NamedIndividual rdf:about="&companies-geo;Oceania">
        <rdf:type rdf:resource="&companies-geo;Continent"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Paris -->

    <owl:NamedIndividual rdf:about="&companies-geo;Paris">
        <rdf:type rdf:resource="&companies-geo;City"/>
        <companies-geo:capitalOf rdf:resource="&companies-geo;France"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/Rome -->

    <owl:NamedIndividual rdf:about="&companies-geo;Rome">
        <rdf:type rdf:resource="&companies-geo;GeoEntity"/>
        <companies-geo:capitalOf rdf:resource="&companies-geo;Italy"/>
        <companies-geo:partOfRegion rdf:resource="&companies-geo;Lazio"/>
    </owl:NamedIndividual>
    


    <!-- http://www.inside.disco.unimib.it/ds/test/companies-geo/SAP -->

    <owl:NamedIndividual rdf:about="&companies-geo;SAP">
        <rdf:type rdf:resource="&companies-geo;Company"/>
        <companies-geo:hasHeadquartersIn rdf:resource="&companies-geo;Germany"/>
    </owl:NamedIndividual>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description>
        <rdf:type rdf:resource="&owl;AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="&companies-geo;City"/>
            <rdf:Description rdf:about="&companies-geo;Continent"/>
            <rdf:Description rdf:about="&companies-geo;Country"/>
            <rdf:Description rdf:about="&companies-geo;Region"/>
        </owl:members>
    </rdf:Description>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Rules
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="&untitled-ontology-15;y">
        <rdf:type rdf:resource="&swrl;Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="&untitled-ontology-15;x">
        <rdf:type rdf:resource="&swrl;Variable"/>
    </rdf:Description>
    <rdf:Description>
