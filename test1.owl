###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Avada_Kedavra

untitled-ontology-10:Avada_Kedavra rdf:type owl:NamedIndividual .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Darco_Malfoy

untitled-ontology-10:Darco_Malfoy rdf:type untitled-ontology-10:Student ,
                                           owl:NamedIndividual ;
                                  
                                  untitled-ontology-10:attendsSchool untitled-ontology-10:Hogwarts ;
                                  
                                  untitled-ontology-10:belongsToHouse untitled-ontology-10:Slytherin ;
                                  
                                  untitled-ontology-10:enemyOf untitled-ontology-10:Voldemort .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Expelliarmus

untitled-ontology-10:Expelliarmus rdf:type owl:NamedIndividual .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Gryffindor

untitled-ontology-10:Gryffindor rdf:type untitled-ontology-10:House ,
                                         owl:NamedIndividual .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Harry_Potter

untitled-ontology-10:Harry_Potter rdf:type owl:NamedIndividual ;
                                  
                                  untitled-ontology-10:castsSpell untitled-ontology-10:Expelliarmus ;
                                  
                                  untitled-ontology-10:belongsToHouse untitled-ontology-10:Gryffindor ;
                                  
                                  untitled-ontology-10:attendsSchool untitled-ontology-10:Hogwarts ;
                                  
                                  untitled-ontology-10:friendOf untitled-ontology-10:Ron_Weasley .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Hermione_Granger

untitled-ontology-10:Hermione_Granger rdf:type untitled-ontology-10:Student ,
                                               owl:NamedIndividual ;
                                      
                                      untitled-ontology-10:belongsToHouse untitled-ontology-10:Gryffindor ;
                                      
                                      untitled-ontology-10:attendsSchool untitled-ontology-10:Hogwarts ;
                                      
                                      untitled-ontology-10:castsSpell untitled-ontology-10:Lumos ;
                                      
                                      untitled-ontology-10:friendOf untitled-ontology-10:Ron_Weasley .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Hermonie_Granger

untitled-ontology-10:Hermonie_Granger rdf:type owl:NamedIndividual .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Hogwarts

untitled-ontology-10:Hogwarts rdf:type owl:NamedIndividual .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Lumos

untitled-ontology-10:Lumos rdf:type owl:NamedIndividual .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Potions

untitled-ontology-10:Potions rdf:type owl:NamedIndividual .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Ron_Weasley

untitled-ontology-10:Ron_Weasley rdf:type owl:NamedIndividual ;
                                 
                                 untitled-ontology-10:belongsToHouse untitled-ontology-10:Gryffindor ;
                                 
                                 untitled-ontology-10:attendsSchool untitled-ontology-10:Hogwarts .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Severus_Snape

untitled-ontology-10:Severus_Snape rdf:type untitled-ontology-10:Professor ,
                                            owl:NamedIndividual ;
                                   
                                   untitled-ontology-10:teaches untitled-ontology-10:Potions .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Slytherin

untitled-ontology-10:Slytherin rdf:type owl:NamedIndividual .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Voldemort

untitled-ontology-10:Voldemort rdf:type owl:NamedIndividual ;
                               
                               untitled-ontology-10:castsSpell untitled-ontology-10:Avada_Kedavra .





