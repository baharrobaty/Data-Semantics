@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix untitled-ontology-10: <http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#> .
@base <http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10> .

<http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10> rdf:type owl:Ontology .


#################################################################
#
#    Object Properties
#
#################################################################


###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#attendsSchool

untitled-ontology-10:attendsSchool rdf:type owl:ObjectProperty ;
                                   
                                   rdfs:range untitled-ontology-10:School ;
                                   
                                   rdfs:domain untitled-ontology-10:Student ;
                                   
                                   rdfs:subPropertyOf owl:topObjectProperty .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#belongsToHouse

untitled-ontology-10:belongsToHouse rdf:type owl:ObjectProperty ;
                                    
                                    rdfs:range untitled-ontology-10:House ;
                                    
                                    rdfs:domain untitled-ontology-10:Student ;
                                    
                                    owl:inverseOf untitled-ontology-10:hasMember ;
                                    
                                    rdfs:subPropertyOf owl:topObjectProperty .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#castsSpell

untitled-ontology-10:castsSpell rdf:type owl:ObjectProperty ;
                                
                                rdfs:range untitled-ontology-10:Spell ;
                                
                                rdfs:domain untitled-ontology-10:Wizard ;
                                
                                rdfs:subPropertyOf owl:topObjectProperty .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#enemyOf

untitled-ontology-10:enemyOf rdf:type owl:ObjectProperty ;
                             
                             rdfs:range untitled-ontology-10:Wizard ;
                             
                             rdfs:domain untitled-ontology-10:Wizard ;
                             
                             rdfs:subPropertyOf owl:topObjectProperty .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#friendOf

untitled-ontology-10:friendOf rdf:type owl:ObjectProperty ,
                                       owl:SymmetricProperty ;
                              
                              rdfs:range untitled-ontology-10:Student ;
                              
                              rdfs:domain untitled-ontology-10:Student ;
                              
                              rdfs:subPropertyOf owl:topObjectProperty .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#hasFather

untitled-ontology-10:hasFather rdf:type owl:ObjectProperty ;
                               
                               rdfs:range untitled-ontology-10:Person ;
                               
                               rdfs:domain untitled-ontology-10:Person .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#hasGodfather

untitled-ontology-10:hasGodfather rdf:type owl:ObjectProperty ;
                                  
                                  rdfs:range untitled-ontology-10:Person ;
                                  
                                  rdfs:domain untitled-ontology-10:Person .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#hasMember

untitled-ontology-10:hasMember rdf:type owl:ObjectProperty ;
                               
                               owl:propertyDisjointWith untitled-ontology-10:taughtBy ;
                               
                               rdfs:subPropertyOf owl:topObjectProperty .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#hasMother

untitled-ontology-10:hasMother rdf:type owl:ObjectProperty ;
                               
                               rdfs:domain untitled-ontology-10:Person ;
                               
                               rdfs:range untitled-ontology-10:Person .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#marriedTo

untitled-ontology-10:marriedTo rdf:type owl:ObjectProperty ,
                                        owl:SymmetricProperty ;
                               
                               rdfs:domain untitled-ontology-10:Person ;
                               
                               rdfs:range untitled-ontology-10:Person .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#ownerOf

untitled-ontology-10:ownerOf rdf:type owl:ObjectProperty ;
                             
                             rdfs:domain untitled-ontology-10:Person ;
                             
                             rdfs:range owl:Thing .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#taughtBy

untitled-ontology-10:taughtBy rdf:type owl:ObjectProperty ;
                              
                              owl:inverseOf untitled-ontology-10:teaches ;
                              
                              rdfs:subPropertyOf owl:topObjectProperty .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#teaches

untitled-ontology-10:teaches rdf:type owl:ObjectProperty ;
                             
                             rdfs:domain untitled-ontology-10:Professor ;
                             
                             rdfs:range untitled-ontology-10:Spell ;
                             
                             rdfs:subPropertyOf owl:topObjectProperty .





#################################################################
#
#    Data properties
#
#################################################################


###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#hasAge

untitled-ontology-10:hasAge rdf:type owl:DatatypeProperty ;
                            
                            rdfs:domain untitled-ontology-10:Person ;
                            
                            rdfs:range xsd:integer ;
                            
                            rdfs:subPropertyOf owl:topDataProperty .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#hasName

untitled-ontology-10:hasName rdf:type owl:DatatypeProperty ;
                             
                             rdfs:range xsd:string ;
                             
                             rdfs:domain owl:Thing ;
                             
                             rdfs:subPropertyOf owl:topDataProperty .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#hasTitle

untitled-ontology-10:hasTitle rdf:type owl:DatatypeProperty ;
                              
                              rdfs:domain untitled-ontology-10:Spell ;
                              
                              rdfs:range xsd:string ;
                              
                              rdfs:subPropertyOf owl:topDataProperty .





#################################################################
#
#    Classes
#
#################################################################


###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#DarkWizard

untitled-ontology-10:DarkWizard rdf:type owl:Class ;
                                
                                rdfs:subClassOf untitled-ontology-10:Person .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#House

untitled-ontology-10:House rdf:type owl:Class ;
                           
                           owl:disjointWith untitled-ontology-10:Person ,
                                            untitled-ontology-10:Spell .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Person

untitled-ontology-10:Person rdf:type owl:Class .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Professor

untitled-ontology-10:Professor rdf:type owl:Class ;
                               
                               rdfs:subClassOf untitled-ontology-10:Person ;
                               
                               owl:disjointWith untitled-ontology-10:Student .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#School

untitled-ontology-10:School rdf:type owl:Class .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Spell

untitled-ontology-10:Spell rdf:type owl:Class .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Student

untitled-ontology-10:Student rdf:type owl:Class ;
                             
                             rdfs:subClassOf untitled-ontology-10:Person ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty untitled-ontology-10:belongsToHouse ;
                                               owl:someValuesFrom untitled-ontology-10:House
                                             ] .



###  http://www.semanticweb.org/utente/ontologies/2026/4/untitled-ontology-10#Wizard

untitled-ontology-10:Wizard rdf:type owl:Class ;
                            
                            rdfs:subClassOf untitled-ontology-10:Person .





